#!/usr/bin/env python3
"""Private-bytecode launcher for the Talk mirror daemon."""
import os
import sys
from pathlib import Path

cache = os.environ.get("XDG_CACHE_HOME", "")
root = Path(cache) if os.path.isabs(cache) else Path.home() / ".cache"
sys.pycache_prefix = str(root / "omanctalk" / "pycache")

from nctalk.sync import main

raise SystemExit(main())
